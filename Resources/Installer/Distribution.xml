<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>TuneFlick</title>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="tuneflick"/>
    </choices-outline>
    <choice id="tuneflick" title="TuneFlick" description="TuneFlick" visible="false">
        <pkg-ref id="com.tuneflick.installer"/>
    </choice>
    <pkg-ref id="com.tuneflick.installer">TuneFlick.pkg</pkg-ref>
    <pkg-ref id="com.tuneflick.installer">
        <must-close>
            <app id="com.tuneflick.app"/>
        </must-close>
    </pkg-ref>
</installer-gui-script>
